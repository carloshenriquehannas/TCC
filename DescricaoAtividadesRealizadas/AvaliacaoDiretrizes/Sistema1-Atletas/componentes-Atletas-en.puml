@startuml componentes - atletas - en
left to right direction
'skinparam componentStyle rectangle

component "Athlete Profiles\n& Portfolios" as PerfisPortfolio
component "Content\n& Moderation" as ConteudoModeracao
component "Communication\n(Messaging & Feedback)" as Comunicacao
component "Schedule\n& Participation" as AgendaParticipacoes
component "Sponsorships\n& Contracts\n(including negotiation)" as PatrociniosContratos
component "Career\n& Performance" as CarreiraDesempenho
component "Club Management" as GestaoClubes
component "Analytics\n(Reports / ROI)" as Analytics

' ==========================
' Dependências basais (dados de atleta)
' ==========================
ConteudoModeracao ..> PerfisPortfolio : Consult the athlete's profile/portfolio\nfor publishing/approval
Comunicacao ..> PerfisPortfolio : Sender/recipient context\nthrough profiles
AgendaParticipacoes ..> PerfisPortfolio : Map athletes registered\nfor events/competitions
PatrociniosContratos ..> PerfisPortfolio : Athlete–sponsor link\n(eligibility/scope)
CarreiraDesempenho ..> PerfisPortfolio : Athlete data for\ncareer planning
GestaoClubes ..> PerfisPortfolio : Data on athletes associated\nwith the club

' ==========================
' Calendário incluído por monitoramento/participação (<<include>>)
' ==========================
CarreiraDesempenho ..> AgendaParticipacoes : <<include>> Calendar for\nmonitoring progress
GestaoClubes ..> AgendaParticipacoes : <<include>> Calendar for\nmanaging participation

' ==========================
' Conteúdo & patrocínio (<<extend>> aprovação)
' ==========================
ConteudoModeracao ..> PatrociniosContratos : <<extend>> Content approval in\nthe sponsorship context

' ==========================
' Comunicação no contexto de contratos/negociações
' (associação sem dependência ⇒ linha contínua)
' ==========================
Comunicacao --> PatrociniosContratos : Discussion of terms,\nfeedback and negotiation

' ==========================
' Relatórios incluídos na gestão de patrocínios (<<include>>)
' ==========================
PatrociniosContratos ..> Analytics : <<include>> Reports/ROI for monitoring

' ==========================
' Clubes referenciam dados de patrocinadores
' ==========================
GestaoClubes ..> PatrociniosContratos : Sponsor details and\nathlete associations

' ==========================
' Negociação como extensão da gestão de carreira/contratos (<<extend>>)
' ==========================
PatrociniosContratos ..> CarreiraDesempenho : <<extend>> Contract negotiation in the\ncontext of career management

@enduml
